@model BloodBankManagementSystem.Models.BloodRequest
@{
    ViewData["Title"] = "New Blood Request";
}

<h1>New Blood Request</h1>

<div class="row">
    <div class="col-md-5">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="mb-3">
                <label asp-for="PatientName" class="form-label"></label>
                <input asp-for="PatientName" class="form-control" />
                <span asp-validation-for="PatientName" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="HospitalName" class="form-label"></label>
                <input asp-for="HospitalName" class="form-control" />
                <span asp-validation-for="HospitalName" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="BloodGroup" class="form-label"></label>
                <select asp-for="BloodGroup" class="form-select"
                        asp-items="Html.GetEnumSelectList<BloodBankManagementSystem.Models.BloodGroup>()"></select>
                <span asp-validation-for="BloodGroup" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="UnitsRequired" class="form-label"></label>
                <input asp-for="UnitsRequired" class="form-control" />
                <span asp-validation-for="UnitsRequired" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="ContactNumber" class="form-label"></label>
                <input asp-for="ContactNumber" class="form-control" />
                <span asp-validation-for="ContactNumber" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-primary">Submit Request</button>
            <a asp-action="Index" class="btn btn-secondary">Back</a>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}