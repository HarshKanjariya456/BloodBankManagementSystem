@model BloodBankManagementSystem.Models.DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
    const int LowStockLimit = 5;
}

<h1 class="mb-4">Dashboard</h1>

<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="card text-bg-primary h-100">
            <div class="card-body">
                <h6>Total Donors</h6><h2>@Model.TotalDonors</h2>
                <small>@Model.EligibleDonors eligible now</small>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card text-bg-success h-100">
            <div class="card-body">
                <h6>Total Blood Units</h6><h2>@Model.TotalUnits</h2>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card text-bg-warning h-100">
            <div class="card-body">
                <h6>Pending Requests</h6><h2>@Model.PendingRequests</h2>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card text-bg-secondary h-100">
            <div class="card-body">
                <h6>Approved / Rejected</h6><h2>@Model.ApprovedRequests / @Model.RejectedRequests</h2>
            </div>
        </div>
    </div>
</div>

<h4>Stock by Blood Group</h4>
<div class="row g-3">
    @foreach (var s in Model.Stocks)
    {
        var color = s.Units == 0 ? "danger" : s.Units < LowStockLimit ? "warning" : "success";
        <div class="col-6 col-md-3">
            <div class="card border-@color">
                <div class="card-body text-center">
                    <h5>@s.BloodGroup</h5>
                    <h3 class="text-@color">@s.Units</h3>
                    <small class="text-muted">units</small>
                </div>
            </div>
        </div>
    }
</div>